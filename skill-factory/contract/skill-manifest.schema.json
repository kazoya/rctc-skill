{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kazoya/rctc-skill/skill-factory/contract/skill-manifest.schema.json",
  "title": "RCTC Skill Manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "description",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "side_effect_level": {
      "enum": [
        "none",
        "reversible",
        "consequential"
      ]
    },
    "reversible": {
      "type": "boolean"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compatible_agents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "string"
    },
    "rollback": {
      "type": "string"
    },
    "provenance": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "validated",
        "reviewed",
        "released"
      ]
    }
  },
  "additionalProperties": true
}
