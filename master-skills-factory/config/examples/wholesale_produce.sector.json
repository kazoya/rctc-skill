  "aiKnowledgeSources": ["synthetic_catalog_only"],
  "escalation": { "onIncompleteRfq": "human_merchant", "onPriceInjection": "refuse" },
  "dashboard": { "roles": ["merchant"], "permissions": ["read_own_tenant"] }
